  "cards": [
    {
      "dot": "cyan",
      "title": "CDC pipeline",
      "items": [
        "mock-pm-app seeds Postgres with synthetic PM traffic",
        "Debezium turns every row change into a Kafka event, no dual writes"
      ]
    },
    {
      "dot": "amber",
      "title": "Market ingestion",
      "items": [
        "market-ingestor publishes to Kinesis",
        "A dedicated bridge republishes onto Kafka — Flink 2.x dropped the legacy Kinesis source"
      ]
    },
    {
      "dot": "emerald",
      "title": "Windowing (Phase 26)",
      "items": [
        "Market Pulse Job runs 3 independent 5-min tumbling windows: market pulse, bookings created, bookings cancelled",
        "Per-source watermarks/idleness, ValueState dedup with TTL, and an Async I/O profit lookup — none of which the Pricing Job needs"
      ]
    },
    {
      "dot": "rose",
      "title": "Storage & serving",
      "items": [
        "DynamoDB is the single writer; Iceberg is derived via its own Streams, never a second direct write",
        "Dashboard reads DynamoDB directly (hot path) and dbt/DuckDB marts (cold path)"
      ]
    }
  ]
