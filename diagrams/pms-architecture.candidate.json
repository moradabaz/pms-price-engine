        "id": "market-ingestion",
        "label": "Market ingestion",
        "focus": [
          "marketIngestor",
          "kinesis",
          "bridge",
          "kafka"
        ],
        "note": "Market snapshots ride Kinesis, then a bridge republishes them onto Kafka for Flink to consume."
      },
      {
        "id": "market-pulse-windows",
        "label": "Market Pulse windows",
        "focus": [
          "kafka",
          "marketPulseJob",
          "dynamodb"
        ],
        "note": "3 independent 5-min tumbling windows, per-source watermarks/idleness, dedup and Async I/O — none of which the pricing job needs."
      },
      {
        "id": "lakehouse-and-serving",
        "label": "Lakehouse & serving",
        "focus": [
          "dynamodb",
          "lakehouseConsumer",
          "iceberg",
          "dbtDuckdb",
          "dashboard"
        ],
        "note": "DynamoDB is the hot path; its own Streams feed the cold-path lakehouse dbt builds marts from."
      }
    ]
  },
