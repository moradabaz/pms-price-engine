{
  "name": "pms-payment-lines-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",

    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "pms",
    "database.password": "pms",
    "database.dbname": "pms_db",

    "topic.prefix": "pms",
    "table.include.list": "public.payment_lines,public.apartment_market_segments,public.owner_contracts,public.manual_overrides",

    "slot.name": "debezium_payment_lines",
    "plugin.name": "pgoutput",
    "publication.name": "dbz_publication",
    "publication.autocreate.mode": "filtered",

    "snapshot.mode": "initial",

    "message.key.columns": "public.payment_lines:apartment_id",

    "decimal.handling.mode": "double",

    "converters": "dates",
    "dates.type": "com.pms.debezium.DateStringConverter",
    "dates.format.date": "yyyy-MM-dd",

    "transforms": "unwrap,routePayments,routeSegments,routeOwnerContracts,routeManualOverrides",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "true",
    "transforms.unwrap.delete.handling.mode": "drop",
    "transforms.routePayments.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.routePayments.regex": "pms\\.public\\.payment_lines",
    "transforms.routePayments.replacement": "payment-events.v1",
    "transforms.routeSegments.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.routeSegments.regex": "pms\\.public\\.apartment_market_segments",
    "transforms.routeSegments.replacement": "apartment-market-segments.v1",
    "transforms.routeOwnerContracts.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.routeOwnerContracts.regex": "pms\\.public\\.owner_contracts",
    "transforms.routeOwnerContracts.replacement": "owner-contracts.v1",
    "transforms.routeManualOverrides.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.routeManualOverrides.regex": "pms\\.public\\.manual_overrides",
    "transforms.routeManualOverrides.replacement": "manual-overrides.v1",

    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",

    "errors.tolerance": "none"
  }
}
